{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/spec/schemas/project.schema.json",
  "title": "Atlas project manifest",
  "description": "The facts a content repository states about itself. Enforced by `atlas validate project.yaml` and by the manifest-valid gate.",
  "type": "object",
  "required": ["standard", "name", "kind", "stage", "maturity", "owner", "audiences"],
  "additionalProperties": false,
  "properties": {
    "standard": {
      "type": "string",
      "pattern": "^editorial/[0-9]+\\.[0-9]+$",
      "description": "Contract version of the standard this repository is written against."
    },
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "kind": {
      "type": "string",
      "enum": ["standards", "guide", "reference", "handbook", "marketing", "product", "support", "internal", "mixed"],
      "description": "What kind of content this repository holds. See MATRIX."
    },
    "stage": {"type": "string", "enum": ["idea", "draft", "active", "maintained", "frozen", "retired"]},
    "maturity": {"type": "string", "enum": ["sketch", "working", "stable", "authoritative"]},
    "owner": {"type": "string", "pattern": "^(person|role|team):[a-z0-9-]+$"},
    "audiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["internal", "leadership", "customers", "partners", "developers", "press", "candidates", "public"]
      }
    },
    "channels": {
      "type": "array",
      "items": {"type": "string", "enum": ["docs-site", "handbook", "website", "blog", "email", "in-product", "social", "print", "repository"]}
    },
    "languages": {"type": "array", "items": {"type": "string"}},
    "visibility": {"type": "string", "enum": ["public", "internal", "confidential"]},
    "support": {"type": "string", "enum": ["maintained", "best-effort", "none"]},
    "successor": {"type": ["string", "null"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {"type": "string", "maxLength": 160},
        "website": {"type": "string"},
        "topics": {"type": "array", "minItems": 3, "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}}
      }
    },
    "links": {"type": "object", "additionalProperties": {"type": "string"}},
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "description": "House numbers for the linter. Omit to accept the defaults.",
      "properties": {
        "max_sentence_words": {"type": "integer", "minimum": 12, "maximum": 60},
        "max_paragraph_sentences": {"type": "integer", "minimum": 2, "maximum": 12},
        "max_heading_depth": {"type": "integer", "minimum": 2, "maximum": 6},
        "required_fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
