{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/spec/schemas/workstream.schema.json",
  "title": "Atlas workstream manifest",
  "description": "One editorial initiative: what is being written, for whom, by whom, and where it stands.",
  "type": "object",
  "required": ["id", "title", "status", "owner", "kind", "audience", "opened"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{2}_[a-z0-9]+(-[a-z0-9]+)*$"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["planned", "active", "blocked", "review", "published", "closed"]},
    "owner": {"type": "string", "pattern": "^(person|role|team|agent):[a-z0-9-]+$"},
    "kind": {"type": "string"},
    "audience": {"type": "string"},
    "opened": {"type": "string", "format": "date"},
    "target": {"type": ["string", "null"], "description": "Target publication date, or null while unscheduled."},
    "standards": {"type": "array", "items": {"type": "string"}},
    "closed": {"type": ["string", "null"]},
    "note": {"type": "string"}
  }
}
