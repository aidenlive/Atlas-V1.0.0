{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example/spec/schemas/authority.schema.json",
  "title": "Atlas authority manifest",
  "description": "Who may write, review, approve, and retire content here. Declared, so that approval is a fact rather than a memory.",
  "type": "object",
  "required": ["standard", "principals", "roles", "approvals"],
  "additionalProperties": false,
  "properties": {
    "standard": {"type": "string", "pattern": "^editorial/[0-9]+\\.[0-9]+$"},
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(person|role|team|agent):[a-z0-9-]+$"},
          "name": {"type": "string"},
          "kind": {"type": "string", "enum": ["person", "role", "team", "agent"]},
          "contact": {"type": "string"}
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "held_by", "may"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "held_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "may": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["draft", "edit", "review", "approve", "publish", "retire", "change-standard"]}
          },
          "note": {"type": "string"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "description": "What each kind of change needs before it ships.",
      "items": {
        "type": "object",
        "required": ["change", "requires"],
        "additionalProperties": false,
        "properties": {
          "change": {"type": "string"},
          "requires": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "note": {"type": "string"}
        }
      }
    },
    "escalation": {"type": "array", "items": {"type": "string"}},
    "review_cadence_days": {"type": "integer", "minimum": 30, "maximum": 1095}
  }
}
